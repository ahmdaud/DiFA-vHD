/** Simbol kotak centang: ☒ jika aktif/terpilih, ☐ jika tidak. */
function kotak_(aktif) { 
  return aktif ? '<span style="font-family:Arial, sans-serif; font-weight:bold;">&#9745;</span>' : '&#9744;'; 
}

/**
 * Mencocokkan teks bebas (mis. "Wakil Ketua Pengadilan" / "Hakim - Drs. Fulan" dari MasterPejabat)
 * ke label resmi form cetak. Prioritas: sama persis, lalu label resmi TERPANJANG yang termuat
 * dalam teks (sehingga "Wakil Ketua Pengadilan" -> "Wakil Ketua", bukan "Ketua").
 * longgar=true (dipakai untuk Petunjuk) juga menerima teks singkat yang termuat dalam label,
 * mis. "Setuju" -> "Setuju Sesuai Ketentuan yang berlaku".
 */
function cariResmi_(teks, daftar, longgar) {
  if (!teks) return null;
  const t = String(teks).trim().toLowerCase();
  if (!t || t === '-') return null;

  let found = daftar.find(function (o) { return o.toLowerCase() === t; });
  if (found) return found;

  const termuat = daftar.filter(function (o) { return t.indexOf(o.toLowerCase()) > -1; })
    .sort(function (a, b) { return b.length - a.length; });
  if (termuat.length) return termuat[0];

  if (longgar && t.length >= 4) {
    found = daftar.find(function (o) { return o.toLowerCase().indexOf(t) > -1; });
    if (found) return found;
  }
  return null;
}

/** Format tanggal ke gaya Indonesia, mis. "24 September 2026". Menerima Date atau string. */
function tglIndo_(val) {
  if (!val) return '';
  const d = (val instanceof Date) ? val : new Date(val);
  if (isNaN(d)) return String(val);
  return Utilities.formatDate(d, Session.getScriptTimeZone(), 'dd MMMM yyyy');
}

/** Ambil logo dari Google Drive (link yang diberikan user) sebagai data URI; fallback ke logo bawaan jika gagal. */
function getLogoDataUri_() {
  // Logo di-cache 6 jam supaya cetak berikutnya tidak perlu membaca Drive lagi (jauh lebih cepat).
  const cache = CacheService.getScriptCache();
  try {
    const cached = cache.get('logo_disposisi_uri');
    if (cached) return cached;
  } catch (e) { /* cache tidak tersedia, lanjut */ }
  try {
    const file = DriveApp.getFileById(LOGO_DRIVE_FILE_ID);
    const blob = file.getBlob();
    const base64 = Utilities.base64Encode(blob.getBytes());
    const uri = 'data:' + blob.getContentType() + ';base64,' + base64;
    try { if (uri.length < 95000) cache.put('logo_disposisi_uri', uri, 21600); } catch (e) { /* terlalu besar, abaikan */ }
    return uri;
  } catch (e) {
    Logger.log('Gagal ambil logo dari Drive (' + LOGO_DRIVE_FILE_ID + '), pakai logo bawaan: ' + e);
    return 'data:image/png;base64,' + LOGO_BASE64_FALLBACK;
  }
}

