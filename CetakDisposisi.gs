/**
 * Menghasilkan PDF Lembar Disposisi untuk satu surat (mencakup SELURUH
 * rantai disposisi berjenjang), lalu mengembalikan URL-nya.
 * Dipanggil dari tombol cetak di menu Disposisi.
 */
function siapkanDataLembar_(kodeTracking) {
  const suratRow = findSuratByKode(kodeTracking);
  if (!suratRow) return { success: false, message: 'Surat dengan kode tracking tersebut tidak ditemukan.' };
  const s = suratRow.data;

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const semuaDisposisi = readSheetAsObjects(ss, SHEET_NAMES.DISPOSISI);
  const rantai = semuaDisposisi.filter(function (r) { return r['Kode Tracking'] === kodeTracking; });

  const iso = function (v) { return (v instanceof Date) ? v.toISOString() : v; };
  const daftarJejak = rantai.map(function (r) {
    return {
      'Kepada': r['Diteruskan Kepada'] || '-',
      'Petunjuk': r['Petunjuk Disposisi'] || '-',
      'Dari': r['Pimpinan'] || '-',
      'Catatan': r['Catatan'] || '',
      'Dibuat Pada': iso(r['Tanggal Disposisi']),
      'Status': r['Status Tindak Lanjut'] || '-'
    };
  });
  // Surat lama belum punya baris awal -> tambahkan secara virtual agar jejak tetap lengkap.
  if (!rantai.length || String(rantai[0]['Pimpinan']) !== LABEL_INPUT_ADMIN) {
    daftarJejak.unshift({
      'Kepada': s['Pimpinan Tujuan'] || '-', 'Petunjuk': '-', 'Dari': LABEL_INPUT_ADMIN, 'Catatan': '',
      'Dibuat Pada': iso(s['Diterima Tanggal']), 'Status': STATUS_MENUNGGU
    });
  }

  const suratForTemplate = {
    'Nomor Surat Asal': s['Nomor Naskah Dinas'],
    'Tanggal Surat': s['Tanggal Naskah Dinas'],
    'Lampiran': s['Lampiran (URL)'] ? 'Ada' : '-',
    'Status Naskah': s['Status Naskah'],
    'Sifat': s['Sifat'],
    'Jenis': s['Jenis'],
    'Tanggal Diterima': s['Diterima Tanggal'],
    'No Agenda': s['No. Agenda'],
    'Unit': s['Index'],
    'Asal Surat': s['Dari'],
    'Perihal': s['Hal'],
    'Tujuan Awal': s['Pimpinan Tujuan'],
    disposisi: daftarJejak
  };

  return { success: true, surat: suratForTemplate };
}

/**
 * CEPAT: hanya mengembalikan HTML lembar disposisi untuk ditampilkan sebagai preview popup
 * di browser & dicetak langsung (Cetak / Simpan sebagai PDF). Tanpa Drive API & konversi Docs.
 */
function getLembarDisposisiHtml(kodeTracking) {
  const d = siapkanDataLembar_(kodeTracking);
  if (!d.success) return d;
  return { success: true, html: lembarDisposisiHtml_(d.surat), kodeTracking: kodeTracking };
}

/**
 * (Opsional, lambat 5–15 dtk) Membuat FILE PDF permanen di Drive lewat konversi Google Docs.
 * Hanya dipanggil bila pengguna menekan "Simpan PDF ke Drive".
 */
function cetakLembarDisposisi(kodeTracking) {
  const d = siapkanDataLembar_(kodeTracking);
  if (!d.success) return d;
  const html = lembarDisposisiHtml_(d.surat);
  const htmlBlob = Utilities.newBlob(html, 'text/html', 'Lembar Disposisi - ' + kodeTracking + '.html');

  let pdfBlob;
  try {
    const docFile = Drive.Files.create(
      { name: 'Lembar Disposisi - ' + kodeTracking, mimeType: MimeType.GOOGLE_DOCS },
      htmlBlob
    );
    const gdoc = DriveApp.getFileById(docFile.id);
    pdfBlob = gdoc.getAs('application/pdf');
    gdoc.setTrashed(true);
  } catch (e) {
    return {
      success: false,
      message: 'Gagal membuat PDF: ' + e.message + '. Pastikan "Drive API" sudah diaktifkan di menu Layanan (Services) pada editor Apps Script.'
    };
  }

  const folder = getOrCreateFolder('Lembar Disposisi Cetak');
  const pdfFile = folder.createFile(pdfBlob).setName('Lembar Disposisi - ' + kodeTracking + '.pdf');
  pdfFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

  return {
    success: true,
    pdfUrl: pdfFile.getUrl(),
    previewUrl: 'https://drive.google.com/file/d/' + pdfFile.getId() + '/preview',
    kodeTracking: kodeTracking
  };
}